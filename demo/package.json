{
  "name": "ai-inspector-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:react": "node dev.mjs --app react --bundler vite",
    "dev:react:webpack": "node dev.mjs --app react --bundler webpack",
    "dev:react:rspack": "node dev.mjs --app react --bundler rspack",
    "dev:vue": "node dev.mjs --app vue --bundler vite",
    "dev:vue:webpack": "node dev.mjs --app vue --bundler webpack",
    "dev:webpack": "node dev.mjs --bundler webpack",
    "build": "vite build --config react/vite.config.js",
    "preview": "vite preview --config react/vite.config.js"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.0",
    "@rrweb/replay": "^2.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@rspack/cli": "^1.3.15",
    "@rspack/core": "^1.3.15",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "babel-loader": "^9.2.1",
    "code-inspector-plugin": "^1.5.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "vite": "^8.0.1",
    "vue-loader": "^17.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
