{
  "name": "ide-byebye",
  "version": "0.1.2",
  "description": "Dev plugin for Vite / webpack / rspack / rsbuild / esbuild / Farm (and Turbopack/Mako path injection): ⌘-click any rendered element, describe the change in plain words, and hand the element's source + your intent to Codex App / Claude App / Cursor / Grok Build — no hunting through the IDE.",
  "type": "module",
  "license": "MIT",
  "author": "dravenLee <516342558@qq.com>",
  "homepage": "https://github.com/bo-516/ide-byebye#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bo-516/ide-byebye.git"
  },
  "bugs": {
    "url": "https://github.com/bo-516/ide-byebye/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "webpack",
    "rspack",
    "rsbuild",
    "esbuild",
    "farm",
    "turbopack",
    "mako",
    "unplugin",
    "code-inspector",
    "vue",
    "react",
    "claude",
    "codex",
    "cursor",
    "grok",
    "grok-build",
    "ai",
    "devtools",
    "intent",
    "deeplink",
    "rrweb"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    },
    "./rspack": {
      "types": "./rspack.d.ts",
      "default": "./rspack.js"
    },
    "./rsbuild": {
      "types": "./rsbuild.d.ts",
      "default": "./rsbuild.js"
    },
    "./esbuild": {
      "types": "./esbuild.d.ts",
      "default": "./esbuild.js"
    },
    "./farm": {
      "types": "./farm.d.ts",
      "default": "./farm.js"
    },
    "./turbopack": {
      "types": "./turbopack.d.ts",
      "default": "./turbopack.js"
    },
    "./mako": {
      "types": "./mako.d.ts",
      "default": "./mako.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "plugin.js",
    "vite.js",
    "vite.d.ts",
    "webpack.js",
    "webpack.d.ts",
    "rspack.js",
    "rspack.d.ts",
    "rsbuild.js",
    "rsbuild.d.ts",
    "esbuild.js",
    "esbuild.d.ts",
    "farm.js",
    "farm.d.ts",
    "turbopack.js",
    "turbopack.d.ts",
    "mako.js",
    "mako.d.ts",
    "src/server",
    "src/shared",
    "dist",
    "!**/*.test.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-single-file.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/publish.js",
    "release:dry": "node scripts/publish.js --dry-run"
  },
  "dependencies": {
    "code-inspector-plugin": "^1.6.2",
    "oxc-parser": "^0.143.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "rolldown": "^1.0.0-rc.12"
  },
  "peerDependencies": {
    "@rrweb/record": ">=2.0.0",
    "@rrweb/replay": ">=2.0.0",
    "@rspack/core": ">=0.5",
    "@rsbuild/core": ">=0.5",
    "@farmfe/core": ">=1",
    "esbuild": ">=0.17",
    "vite": ">=4",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "@farmfe/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "@rrweb/record": {
      "optional": true
    },
    "@rrweb/replay": {
      "optional": true
    }
  }
}
