{
  "name": "ide-byebye",
  "version": "0.1.0",
  "description": "Dev plugin for Vite / webpack / rspack: ⌘-click any rendered element, describe the change in plain words, and hand the element's source + your intent to Codex App / Claude App / Cursor — no hunting through the IDE.",
  "type": "module",
  "license": "MIT",
  "author": "dravenLee <516342558@qq.com>",
  "homepage": "https://github.com/dravenLee/ide-byebye#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dravenLee/ide-byebye.git"
  },
  "bugs": {
    "url": "https://github.com/dravenLee/ide-byebye/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "webpack",
    "rspack",
    "unplugin",
    "code-inspector",
    "claude",
    "codex",
    "cursor",
    "ai",
    "devtools",
    "intent",
    "deeplink",
    "rrweb"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./vite": "./vite.js",
    "./webpack": "./webpack.js",
    "./rspack": "./rspack.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "vite.js",
    "webpack.js",
    "rspack.js",
    "src/server",
    "src/shared",
    "dist",
    "!**/*.test.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-single-file.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "code-inspector-plugin": "^1.6.2",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "rolldown": "^1.0.0-rc.12"
  },
  "peerDependencies": {
    "@rrweb/record": ">=2.0.0",
    "@rrweb/replay": ">=2.0.0",
    "@rspack/core": ">=0.5",
    "vite": ">=4",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "@rrweb/record": {
      "optional": true
    },
    "@rrweb/replay": {
      "optional": true
    }
  }
}
