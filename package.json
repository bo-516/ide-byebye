{
  "name": "ide-byebye",
  "version": "0.1.3",
  "description": "Dev plugin for Vite / webpack / rspack / rsbuild / esbuild / Farm (and Turbopack/Mako path injection): ⌘-click any rendered element, describe the change in plain words, and hand the element's source + your intent to Codex App / Claude App / Cursor / Grok Build — no hunting through the IDE.",
  "type": "module",
  "license": "MIT",
  "author": "dravenLee <516342558@qq.com>",
  "homepage": "https://github.com/bo-516/ide-byebye#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bo-516/ide-byebye.git"
  },
  "bugs": {
    "url": "https://github.com/bo-516/ide-byebye/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "webpack",
    "rspack",
    "rsbuild",
    "esbuild",
    "farm",
    "turbopack",
    "mako",
    "unplugin",
    "code-inspector",
    "vue",
    "react",
    "claude",
    "codex",
    "cursor",
    "grok",
    "grok-build",
    "ai",
    "devtools",
    "intent",
    "deeplink",
    "rrweb"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite.d.ts",
      "default": "./dist/adapters/vite.js"
    },
    "./webpack": {
      "types": "./dist/adapters/webpack.d.ts",
      "default": "./dist/adapters/webpack.js"
    },
    "./rspack": {
      "types": "./dist/adapters/rspack.d.ts",
      "default": "./dist/adapters/rspack.js"
    },
    "./rsbuild": {
      "types": "./dist/adapters/rsbuild.d.ts",
      "default": "./dist/adapters/rsbuild.js"
    },
    "./esbuild": {
      "types": "./dist/adapters/esbuild.d.ts",
      "default": "./dist/adapters/esbuild.js"
    },
    "./farm": {
      "types": "./dist/adapters/farm.d.ts",
      "default": "./dist/adapters/farm.js"
    },
    "./turbopack": {
      "types": "./dist/adapters/turbopack.d.ts",
      "default": "./dist/adapters/turbopack.js"
    },
    "./mako": {
      "types": "./dist/adapters/mako.d.ts",
      "default": "./dist/adapters/mako.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.entry.tmp.js",
    "!dist/code-intent-inspector.entry.tmp.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node --import tsx scripts/build-single-file.ts",
    "test": "node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts src/**/**/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "release": "node --import tsx scripts/publish.ts",
    "release:dry": "node --import tsx scripts/publish.ts --dry-run"
  },
  "dependencies": {
    "code-inspector-plugin": "^1.6.2",
    "oxc-parser": "^0.143.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rolldown": "^1.0.0-rc.12",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1",
    "@rrweb/record": ">=2.0.0",
    "@rrweb/replay": ">=2.0.0",
    "@rsbuild/core": ">=0.5",
    "@rspack/core": ">=0.5",
    "esbuild": ">=0.17",
    "vite": ">=4",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "@farmfe/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "@rrweb/record": {
      "optional": true
    },
    "@rrweb/replay": {
      "optional": true
    }
  }
}
